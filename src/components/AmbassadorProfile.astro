---
import type { Language } from '../utils/getTranslations';
import { resolveImagePath } from '../utils/getImagePaths';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const content = {
  es: {
    badge: "Embajadora Oficial de Marca",
    name: "Sasha Steele",
    role: "Embajadora Global & Curadora de Estilo de Vida",
    quote: "Mi propósito en Sasha Store es seleccionar solo aquellos productos que realmente aportan calidad, belleza, fitness y bienestar a tu día a día en EE.UU.",
    bio: "Como imagen y embajadora oficial de Sasha Store, Sasha Steele lidera la selección editorial de nuestros productos en Amazon. Su visión combina moda, salud y tecnología funcional para recomendarte solo lo mejor de cada categoría.",
    highlights: [
      { title: "Curaduría Exclusiva", desc: "Selección rigurosa de productos con calificaciones superiores a 4.4 estrellas." },
      { title: "Estilo & Bienestar", desc: "Enfoque en belleza, acondicionamiento físico y hogar inteligente." },
      { title: "Conexión Real", desc: "Reseñas auténticas y presencia activa en plataformas digitales." },
    ],
    followText: "Sigue a Sasha Steele en sus redes oficiales:",
  },
  en: {
    badge: "Official Brand Ambassador",
    name: "Sasha Steele",
    role: "Global Ambassador & Lifestyle Curator",
    quote: "My mission at Sasha Store is to handpick only those products that bring genuine quality, beauty, fitness, and wellness to your daily life in the US.",
    bio: "As the official ambassador of Sasha Store, Sasha Steele leads our editorial selection on Amazon. Her vision merges fashion, health, and functional technology to recommend only the finest products in each category.",
    highlights: [
      { title: "Exclusive Curation", desc: "Strict selection of products with ratings above 4.4 stars." },
      { title: "Style & Wellness", desc: "Focus on beauty, fitness, and smart home essentials." },
      { title: "Authentic Connection", desc: "Genuine reviews and active presence across digital media." },
    ],
    followText: "Follow Sasha Steele on official social channels:",
  },
  pt: {
    badge: "Embaixadora Oficial da Marca",
    name: "Sasha Steele",
    role: "Embaixadora Global e Curadora de Estilo de Vida",
    quote: "Meu objetivo na Sasha Store é selecionar apenas produtos que realmente tragam qualidade, beleza, fitness e bem-estar para o seu dia a dia nos EUA.",
    bio: "Como embaixadora oficial da Sasha Store, Sasha Steele lidera a seleção editorial de nossos produtos na Amazon. Sua visão une moda, saúde e tecnologia funcional para recomendar o melhor de cada categoria.",
    highlights: [
      { title: "Curadoria Exclusiva", desc: "Seleção rigorosa de produtos com avaliações acima de 4.4 estrelas." },
      { title: "Estilo e Bem-estar", desc: "Foco em beleza, fitness e casa inteligente." },
      { title: "Conexão Autêntica", desc: "Avaliações genuínas e presença ativa nas redes digitais." },
    ],
    followText: "Siga Sasha Steele nas redes sociais oficiais:",
  },
};

const current = content[lang] || content.en;
const ambassadorImgSrc = resolveImagePath('/images/sasha-ambassador.jpg');
---

<div class="relative overflow-hidden rounded-3xl bg-white text-neutral-900 p-6 sm:p-10 border border-neutral-200 shadow-soft">
  
  <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    
    <!-- Left Column: Ambassador Portrait Frame -->
    <div class="lg:col-span-5 flex flex-col items-center">
      <div class="relative w-full max-w-sm group">
        
        <!-- Subtle Outer Ring -->
        <div class="absolute -inset-0.5 bg-neutral-200 rounded-[2.15rem] transition duration-300 group-hover:bg-orange-500/40"></div>

        <!-- Image Container -->
        <div class="relative aspect-[9/14] w-full rounded-[2rem] overflow-hidden bg-neutral-100 border border-neutral-200 shadow-md">
          <img
            src={ambassadorImgSrc}
            alt="Sasha Steele - Official Brand Ambassador of Sasha Store"
            class="w-full h-full object-cover object-top transform transition-transform duration-700 group-hover:scale-105"
            loading="eager"
            decoding="async"
          />

          <!-- Verified Tag Overlay Top Right -->
          <div class="absolute top-4 right-4 bg-neutral-950/90 backdrop-blur-md border border-white/20 text-white text-[11px] font-extrabold px-3 py-1.5 rounded-full flex items-center space-x-1.5 shadow-lg">
            <span class="text-orange-400 font-bold">✓</span>
            <span class="tracking-wide">VERIFIED</span>
          </div>

          <!-- Ambassador Pill Bottom Overlay -->
          <div class="absolute bottom-4 left-4 right-4 bg-neutral-950/85 backdrop-blur-md border border-white/20 p-3 rounded-2xl text-center shadow-xl">
            <p class="text-xs font-serif font-bold text-orange-400 tracking-wider uppercase">
              {current.badge}
            </p>
            <p class="text-sm font-sans font-extrabold text-white mt-0.5">
              @sassha_steele
            </p>
          </div>
        </div>

      </div>
    </div>

    <!-- Right Column: Editorial Bio & Social Connect -->
    <div class="lg:col-span-7 space-y-6">
      
      <!-- Category Badge -->
      <div class="flex items-center space-x-2">
        <span class="inline-block w-2 h-2 rounded-full bg-orange-500"></span>
        <span class="text-xs font-bold uppercase tracking-widest text-neutral-900">
          {current.badge}
        </span>
      </div>

      <!-- Title & Role -->
      <div class="space-y-1">
        <h2 class="text-3xl sm:text-4xl font-serif font-black text-neutral-950 tracking-tight">
          {current.name}
        </h2>
        <p class="text-sm font-semibold text-neutral-600">
          {current.role}
        </p>
      </div>

      <!-- Personal Quote Box (Clean Card with Opening & Closing Orange SVG Quote Icons) -->
      <blockquote class="p-5 sm:p-6 rounded-2xl bg-neutral-50 border border-neutral-200 text-neutral-800 text-sm sm:text-base leading-relaxed">
        <div class="flex items-start space-x-3">
          <!-- Opening Quote SVG -->
          <svg class="w-6 h-6 text-orange-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
          </svg>
          
          <!-- Quote Text -->
          <p class="font-medium text-neutral-800 italic flex-1">
            {current.quote}
          </p>

          <!-- Closing Quote SVG -->
          <svg class="w-6 h-6 text-orange-500 flex-shrink-0 self-end mb-0.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.57-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z"/>
          </svg>
        </div>
      </blockquote>

      <!-- Bio Text -->
      <p class="text-xs sm:text-sm text-neutral-700 leading-relaxed font-normal">
        {current.bio}
      </p>

      <!-- Highlights Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
        {current.highlights.map((h) => (
          <div class="p-3.5 rounded-2xl bg-neutral-50 border border-neutral-200 space-y-1">
            <h3 class="text-xs font-bold text-neutral-950 flex items-center space-x-1">
              <span class="text-orange-500">✨</span>
              <span>{h.title}</span>
            </h3>
            <p class="text-[11px] text-neutral-600 leading-snug font-medium">
              {h.desc}
            </p>
          </div>
        ))}
      </div>

      <!-- Social Media Connect -->
      <div class="pt-4 border-t border-neutral-200 space-y-3">
        <p class="text-xs font-bold text-neutral-900">
          {current.followText}
        </p>

        <div class="flex items-center space-x-3 flex-wrap gap-y-2">
          <!-- Instagram -->
          <a
            href="https://www.instagram.com/sassha_steele"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center space-x-2 px-3.5 py-2 rounded-xl bg-gradient-to-tr from-[#f09433] via-[#dc2743] to-[#bc1888] text-white text-xs font-bold shadow-xs hover:scale-105 transition-transform"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            <span>Instagram</span>
          </a>

          <!-- TikTok -->
          <a
            href="https://www.tiktok.com/@sasha_steele.ai"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center space-x-2 px-3.5 py-2 rounded-xl bg-neutral-950 text-white text-xs font-bold shadow-xs hover:scale-105 transition-transform"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
            <span>TikTok</span>
          </a>

          <!-- Pinterest -->
          <a
            href="https://www.pinterest.com/sofiahonzalezoff"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center space-x-2 px-3.5 py-2 rounded-xl bg-[#e60023] text-white text-xs font-bold shadow-xs hover:scale-105 transition-transform"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026z"/></svg>
            <span>Pinterest</span>
          </a>

          <!-- Facebook -->
          <a
            href="https://www.facebook.com/sashasteele.official"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center space-x-2 px-3.5 py-2 rounded-xl bg-[#1877f2] text-white text-xs font-bold shadow-xs hover:scale-105 transition-transform"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            <span>Facebook</span>
          </a>
        </div>
      </div>

    </div>

  </div>
</div>
