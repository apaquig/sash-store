---
import type { Language } from '../utils/getTranslations';

interface FAQItem {
  question: { es: string; en: string };
  answer: { es: string; en: string };
}

interface Props {
  faqs: FAQItem[];
  lang: Language;
  title?: string;
  subtitle?: string;
}

const { faqs, lang, title, subtitle } = Astro.props;
---

<div class="my-12">
  {title && (
    <div class="text-center max-w-2xl mx-auto mb-8 space-y-2">
      <h2 class="text-2xl sm:text-3xl font-serif font-bold text-warm-900">
        {title}
      </h2>
      {subtitle && (
        <p class="text-xs sm:text-sm text-warm-600">
          {subtitle}
        </p>
      )}
    </div>
  )}

  <div class="max-w-3xl mx-auto space-y-4">
    {faqs.map((faq, index) => {
      const q = faq.question[lang] || faq.question.es;
      const a = faq.answer[lang] || faq.answer.es;
      return (
        <details
          class="group bg-white border border-brand-100/80 rounded-2xl shadow-soft overflow-hidden transition-all duration-200"
          open={index === 0}
        >
          <summary class="flex items-center justify-between p-5 cursor-pointer select-none font-serif font-semibold text-sm sm:text-base text-warm-900 group-hover:text-brand-600 transition-colors focus:outline-none">
            <span>{q}</span>
            <span class="ml-4 w-8 h-8 rounded-full bg-brand-50 text-brand-600 flex items-center justify-center transition-transform group-open:rotate-180 flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </span>
          </summary>
          <div class="px-5 pb-5 pt-1 text-xs sm:text-sm text-warm-700 leading-relaxed border-t border-cream-200/60">
            {a}
          </div>
        </details>
      );
    })}
  </div>
</div>
