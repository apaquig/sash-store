---
import type { Language } from '../utils/getTranslations';

interface Props {
  lang: Language;
  t: any;
}

const { lang, t } = Astro.props;
---

<section class="py-8 bg-neutral-50 border-b border-neutral-200">
  <div class="max-w-7xl mx-auto px-4 text-center space-y-2">
    <h1 class="text-3xl font-serif font-bold text-neutral-900">Sasha Store</h1>
    <p class="text-xs text-neutral-600">Catálogo directo de recomendación de productos</p>
  </div>
</section>
