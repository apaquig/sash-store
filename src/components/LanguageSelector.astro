---
import type { Language } from '../utils/getTranslations';
import productsData from '../data/products.json';

interface Props {
  currentLang: Language;
  currentPath: string;
}

const { currentLang, currentPath } = Astro.props;

function getAlternatePath(path: string, targetLang: 'es' | 'en'): string {
  const clean = path.endsWith('/') ? path : `${path}/`;
  
  // 1. Static Page Mapping
  if (clean.includes('/acerca-de') || clean.includes('/about')) {
    return targetLang === 'es' ? '/es/acerca-de/' : '/en/about/';
  }

  if (clean.includes('/divulgacion-afiliados') || clean.includes('/affiliate-disclosure')) {
    return targetLang === 'es' ? '/es/divulgacion-afiliados/' : '/en/affiliate-disclosure/';
  }

  if (clean.includes('/politica-editorial') || clean.includes('/editorial-policy')) {
    return targetLang === 'es' ? '/es/politica-editorial/' : '/en/editorial-policy/';
  }

  if (clean.includes('/privacidad') || clean.includes('/privacy')) {
    return targetLang === 'es' ? '/es/privacidad/' : '/en/privacy/';
  }

  if (clean.includes('/favoritos') || clean.includes('/favorites')) {
    return targetLang === 'es' ? '/es/favoritos/' : '/en/favorites/';
  }

  // 2. Product Page Mapping
  if (clean.includes('/producto/') || clean.includes('/product/') || clean.includes('/produto/')) {
    const parts = clean.split('/').filter(Boolean);
    const slug = parts[parts.length - 1] || '';
    
    // Search product catalog for matching slug
    for (const cat of productsData.categories) {
      for (const prod of cat.products) {
        if (prod.slug.es === slug || prod.slug.en === slug) {
          const targetSlug = prod.slug[targetLang] || prod.slug.en;
          return targetLang === 'es' ? `/es/producto/${targetSlug}/` : `/en/product/${targetSlug}/`;
        }
      }
    }
  }

  // 3. Category Page Mapping
  if (clean.includes('/categoria/') || clean.includes('/category/')) {
    const parts = clean.split('/').filter(Boolean);
    const slug = parts[parts.length - 1] || '';

    // Search category catalog for matching slug
    for (const cat of productsData.categories) {
      if (cat.slug.es === slug || cat.slug.en === slug || cat.id === slug) {
        const targetSlug = cat.slug[targetLang] || cat.slug.en;
        return targetLang === 'es' ? `/es/categoria/${targetSlug}/` : `/en/category/${targetSlug}/`;
      }
    }
  }

  // Default homepage fallback
  return `/${targetLang}/`;
}

const esPath = getAlternatePath(currentPath, 'es');
const enPath = getAlternatePath(currentPath, 'en');
---

<div class="relative inline-flex items-center">
  <!-- Globe Icon -->
  <div class="absolute left-3 pointer-events-none text-neutral-600 z-10">
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m-9 9a9 9 0 019-9"></path>
    </svg>
  </div>

  <!-- Styled Combo Box Dropdown (<select>) -->
  <select
    id="lang-combobox-select"
    class="appearance-none pl-8 pr-7 py-1.5 bg-neutral-100 hover:bg-neutral-200 border border-neutral-300 rounded-full text-xs font-bold text-neutral-900 cursor-pointer focus:outline-none focus:ring-2 focus:ring-neutral-950 transition-colors shadow-xs"
    aria-label="Seleccionar idioma / Select language"
    onchange="if (this.value) window.location.href = this.value;"
  >
    <option value={esPath} selected={currentLang === 'es'}>Español (ES)</option>
    <option value={enPath} selected={currentLang === 'en'}>English (EN)</option>
  </select>

  <!-- Down Chevron Arrow -->
  <div class="absolute right-2.5 pointer-events-none text-neutral-600 z-10">
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
    </svg>
  </div>
</div>
