---
import type { Language } from '../utils/getTranslations';
import LanguageSelector from './LanguageSelector.astro';

interface Props {
  lang: Language;
  currentPath: string;
  t: any;
}

const { lang, currentPath, t } = Astro.props;
const base = `/${lang}`;
---

<!-- Mobile Drawer Modal -->
<div
  id="mobile-menu-drawer"
  class="fixed inset-0 z-50 invisible opacity-0 transition-all duration-300 pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-label={t.nav.openMenu}
>
  <!-- Backdrop overlay -->
  <div
    id="mobile-menu-backdrop"
    class="absolute inset-0 bg-black/50 backdrop-blur-sm transition-opacity duration-300 opacity-0"
  ></div>

  <!-- Sliding panel -->
  <div
    id="mobile-menu-panel"
    class="absolute right-0 top-0 bottom-0 w-full max-w-xs bg-white shadow-2xl p-6 flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-in-out border-l border-neutral-200"
  >
    <!-- Drawer Header -->
    <div>
      <div class="flex items-center justify-between pb-6 border-b border-neutral-200">
        <a href={`${base}/`} class="flex items-center space-x-3">
          <div class="relative flex items-center justify-center">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-neutral-950 via-neutral-800 to-orange-500 p-[2px] shadow-sm">
              <div class="w-full h-full rounded-[10px] bg-neutral-950 flex items-center justify-center">
                <span class="font-serif font-black text-lg text-white">S</span>
              </div>
            </div>
            <span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-orange-500 border-2 border-white rounded-full"></span>
          </div>
          <div class="flex flex-col">
            <span class="font-serif font-black text-lg tracking-[0.18em] text-neutral-950 uppercase leading-none">
              SASHA<span class="text-orange-500 font-serif font-light ml-1">STORE</span>
            </span>
          </div>
        </a>

        <button
          id="close-mobile-menu"
          type="button"
          class="p-2 text-neutral-700 hover:text-orange-500 hover:bg-neutral-100 rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-neutral-900"
          aria-label={t.nav.closeMenu}
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Navigation Links -->
      <nav class="mt-6 flex flex-col space-y-3">
        <a
          href={`${base}/`}
          class={`px-4 py-2.5 rounded-xl font-bold text-xs uppercase tracking-wider transition-all ${
            currentPath === `${base}/` ? 'bg-neutral-950 text-white' : 'text-neutral-900 hover:bg-neutral-100 hover:text-orange-500'
          }`}
        >
          {t.nav.home}
        </a>

        <a
          href={lang === 'es' ? `${base}/acerca-de/` : `${base}/about/`}
          class={`px-4 py-2.5 rounded-xl font-bold text-xs uppercase tracking-wider transition-all ${
            currentPath.includes('about') || currentPath.includes('acerca') ? 'bg-neutral-950 text-white' : 'text-neutral-900 hover:bg-neutral-100 hover:text-orange-500'
          }`}
        >
          {t.nav.about}
        </a>
        <a
          href={lang === 'es' ? `${base}/divulgacion-afiliados/` : `${base}/affiliate-disclosure/`}
          class={`px-4 py-2.5 rounded-xl font-bold text-xs uppercase tracking-wider transition-all ${
            currentPath.includes('afiliad') || currentPath.includes('affiliate') ? 'bg-neutral-950 text-white' : 'text-neutral-900 hover:bg-neutral-100 hover:text-orange-500'
          }`}
        >
          {t.nav.affiliateDisclosure}
        </a>
      </nav>

      <!-- High-Visibility Social Media Section in Drawer -->
      <div class="mt-8 pt-6 border-t border-neutral-200 space-y-3">
        <h4 class="text-[11px] font-bold uppercase tracking-wider text-neutral-500">
          {lang === 'es' ? 'Síguenos en Redes' : 'Follow Us'}
        </h4>
        <div class="grid grid-cols-2 gap-2">
          <!-- Instagram -->
          <a
            href="https://www.instagram.com/sassha_steele"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center space-x-2 px-3 py-2 rounded-xl text-xs font-bold bg-gradient-to-tr from-[#f09433] via-[#dc2743] to-[#bc1888] text-white hover:opacity-95 transition-all shadow-xs"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>Instagram</span>
          </a>

          <!-- TikTok -->
          <a
            href="https://www.tiktok.com/@sasha_steele.ai"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center space-x-2 px-3 py-2 rounded-xl text-xs font-bold bg-neutral-900 text-white hover:bg-black transition-all shadow-xs"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
            </svg>
            <span>TikTok</span>
          </a>

          <!-- Pinterest -->
          <a
            href="https://www.pinterest.com/sofiahonzalezoff"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center space-x-2 px-3 py-2 rounded-xl text-xs font-bold bg-[#e60023] text-white hover:bg-[#ad001a] transition-all shadow-xs"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026z"/>
            </svg>
            <span>Pinterest</span>
          </a>

          <!-- Facebook -->
          <a
            href="https://www.facebook.com/sashasteele.official"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center space-x-2 px-3 py-2 rounded-xl text-xs font-bold bg-[#1877f2] text-white hover:bg-[#0c63d4] transition-all shadow-xs"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>Facebook</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Drawer Footer -->
    <div class="pt-6 border-t border-neutral-200">
      <div class="flex items-center justify-between mb-4">
        <span class="text-xs font-semibold text-neutral-600">{t.language.select}:</span>
        <LanguageSelector currentLang={lang} currentPath={currentPath} />
      </div>
      <p class="text-[11px] text-neutral-400 text-center">
        Sasha Store • US Amazon Associate
      </p>
    </div>
  </div>
</div>

<script>
  const drawer = document.getElementById('mobile-menu-drawer');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const panel = document.getElementById('mobile-menu-panel');
  const closeBtn = document.getElementById('close-mobile-menu');
  const openBtn = document.getElementById('open-mobile-menu');

  function openMenu() {
    if (!drawer || !backdrop || !panel) return;
    drawer.classList.remove('invisible', 'pointer-events-none');
    drawer.classList.add('opacity-100');
    backdrop.classList.remove('opacity-0');
    backdrop.classList.add('opacity-100');
    panel.classList.remove('translate-x-full');
    panel.classList.add('translate-x-0');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeMenu() {
    if (!drawer || !backdrop || !panel) return;
    panel.classList.remove('translate-x-0');
    panel.classList.add('translate-x-full');
    backdrop.classList.remove('opacity-100');
    backdrop.classList.add('opacity-0');
    setTimeout(() => {
      drawer.classList.add('invisible', 'pointer-events-none', 'opacity-0');
      drawer.classList.remove('opacity-100');
      document.body.style.overflow = '';
      openBtn?.focus();
    }, 300);
  }

  openBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.classList.contains('invisible')) {
      closeMenu();
    }
  });
</script>
