---
import type { Language } from '../utils/getTranslations';
import { getImagePaths } from '../utils/getImagePaths';
import AffiliateButton from './AffiliateButton.astro';
import NoImagePlaceholder from './NoImagePlaceholder.astro';

interface Props {
  product: {
    id: string;
    imageNumber?: number;
    imagePrimary?: string;
    imageSecondary?: string;
    categoryId: string;
    price?: number;
    currency?: string;
    slug: { es: string; en: string };
    name: { es: string; en: string };
    shortDescription: { es: string; en: string };
    summary?: { es: string; en: string };
    personalRating: number;
    badge?: { es: string; en: string };
    imageAlt: any;
    affiliateUrl: string;
    isDemo: boolean;
  };
  lang: Language;
  t: any;
  index?: number;
}

const { product, lang, t, index } = Astro.props;

const slug = product.slug[lang] || product.slug.es;
const name = product.name[lang] || product.name.es;
const summaryText = product.summary?.[lang] || product.summary?.es || product.shortDescription[lang] || product.shortDescription.es;
const altText = product.imageAlt?.primary?.[lang] || name;

const productUrl = lang === 'es' ? `/es/producto/${product.slug.es}/` : `/en/product/${product.slug.en}/`;

const images = product.imageNumber ? getImagePaths(product.imageNumber) : { primary: '', secondary: '', fallback: '/src/images/no-image.svg' };
const primarySrc = product.imagePrimary || images.primary || '/src/images/no-image.svg';
const hasImage = Boolean(primarySrc && primarySrc !== '/src/images/no-image.svg');
const badgeText = product.badge?.[lang] || (lang === 'es' ? '#1 más vendido' : '#1 Best Seller');
---

<div
  class="group relative flex flex-col h-full bg-white rounded-3xl border border-neutral-200 hover:border-neutral-900 shadow-soft hover:shadow-hover transition-all duration-300 transform hover:-translate-y-1 overflow-hidden"
  data-product-id={product.id}
  data-category={product.categoryId}
  data-rating={product.personalRating}
  data-name={name.toLowerCase()}
>
  <!-- Card Image Header -->
  <a href={productUrl} class="relative w-full aspect-square bg-neutral-100 overflow-hidden block">
    {hasImage ? (
      <img
        src={primarySrc}
        alt={altText}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover min-w-full min-h-full transition-transform duration-500 group-hover:scale-105"
      />
    ) : (
      <NoImagePlaceholder alt={name} />
    )}

    <!-- Amazon Signature #1 Best Seller Badge -->
    <div class="absolute top-3 left-3 z-10">
      <span class="px-2.5 py-1 rounded-sm bg-[#c45500] text-white text-[11px] font-bold uppercase tracking-wider shadow-sm">
        {badgeText}
      </span>
    </div>
  </a>

  <!-- Card Body Content -->
  <div class="flex flex-col flex-1 p-5 space-y-3">
    
    <!-- Title & Rating -->
    <div class="space-y-1.5">
      <a href={productUrl} class="block group-hover:text-orange-500 transition-colors">
        <h3 class="text-sm font-bold text-neutral-900 leading-snug line-clamp-2">
          {name}
        </h3>
      </a>
      
      <!-- Personal Rating Score -->
      <div class="flex items-center space-x-2">
        <div class="flex text-amber-400">
          {Array.from({ length: 5 }).map((_, i) => (
            <svg class={`w-3.5 h-3.5 ${i < Math.floor(product.personalRating) ? 'fill-current' : 'text-neutral-200'}`} viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
            </svg>
          ))}
        </div>
        <span class="text-xs font-bold text-neutral-800">{product.personalRating} / 5.0</span>
      </div>
    </div>

    <!-- Summary Text Snippet -->
    <p class="text-xs text-neutral-600 line-clamp-3 leading-relaxed flex-1">
      {summaryText}
    </p>

    <!-- Price Tag & CTA Button Area -->
    <div class="pt-3 border-t border-neutral-100 space-y-3 mt-auto">
      
      <!-- Price Display -->
      {product.price > 0 && (
        <div class="flex items-baseline space-x-1.5">
          <span class="text-xl font-serif font-black text-neutral-950">${product.price.toFixed(2)}</span>
          <span class="text-[10px] text-neutral-500 font-bold uppercase">{product.currency || 'USD'}</span>
        </div>
      )}

      <!-- Primary Action: View on Amazon with Unique Effect per Card -->
      <AffiliateButton
        url={product.affiliateUrl}
        isDemo={product.isDemo}
        lang={lang}
        buttonText={t.products.viewOnAmazon}
        variant="card"
        effectIndex={index}
      />

      <!-- Secondary Link: View Details -->
      <a
        href={productUrl}
        class="block text-center text-xs font-bold text-neutral-600 hover:text-neutral-950 py-1 transition-colors"
      >
        {t.products.viewDetails} →
      </a>
    </div>

  </div>
</div>
