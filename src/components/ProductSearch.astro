---
import type { Language } from '../utils/getTranslations';

interface Props {
  lang: Language;
  t: any;
  categories: Array<{
    id: string;
    slug: { es: string; en: string };
    name: { es: string; en: string };
  }>;
}

const { lang, t, categories } = Astro.props;
---

<div class="space-y-4 mb-8">
  <!-- Minimalist Search Input -->
  <div class="relative max-w-xl mx-auto">
    <label for="product-search-input" class="sr-only">
      {t.search.placeholder}
    </label>
    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-neutral-400">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>
    <input
      type="search"
      id="product-search-input"
      placeholder={t.search.placeholder}
      class="w-full pl-10 pr-4 py-2.5 bg-white border border-neutral-300 rounded-xl text-base sm:text-sm text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 focus:ring-1 focus:ring-neutral-900 transition-all shadow-xs"
    />
  </div>

  <!-- Category Filter Pills -->
  <div class="flex items-center justify-start sm:justify-center overflow-x-auto no-scrollbar flex-nowrap sm:flex-wrap gap-2 pt-1 pb-1.5 px-0.5" id="category-pills-wrapper">
    <button
      type="button"
      class="cat-pill active flex-shrink-0 px-4 py-2 rounded-full text-xs font-bold transition-all duration-200 border border-neutral-950 bg-neutral-950 text-white shadow-xs focus:outline-none"
      data-cat="all"
    >
      {t.search.categoryAll}
    </button>
    {categories.map((cat) => (
      <button
        type="button"
        class="cat-pill flex-shrink-0 px-4 py-2 rounded-full text-xs font-semibold transition-all duration-200 border border-neutral-200 bg-neutral-100 text-neutral-900 hover:bg-neutral-900 hover:text-white hover:border-neutral-900 focus:outline-none"
        data-cat={cat.id}
      >
        {cat.name[lang] || cat.name.es}
      </button>
    ))}
  </div>
</div>

<!-- No Results Alert -->
<div id="no-results-box" class="hidden p-6 text-center bg-white border border-neutral-200 rounded-2xl shadow-xs my-6">
  <p class="text-xs font-semibold text-neutral-700">
    {t.products.noProductsFound}
  </p>
</div>

<script>
  const searchInput = document.getElementById('product-search-input') as HTMLInputElement;
  const pills = document.querySelectorAll('.cat-pill');
  const noResultsBox = document.getElementById('no-results-box');

  let activeCategory = 'all';

  function filterProducts() {
    let cards = Array.from(document.querySelectorAll('[data-product-wrapper]')) as HTMLElement[];
    if (!cards.length) {
      cards = Array.from(document.querySelectorAll('[data-product-id]')) as HTMLElement[];
    }
    if (!cards.length) return;

    const query = searchInput?.value.toLowerCase().trim() || '';
    let visibleCount = 0;

    cards.forEach((card) => {
      const name = card.getAttribute('data-name') || '';
      const cat = card.getAttribute('data-category') || '';
      const textContent = card.textContent?.toLowerCase() || '';

      const matchesSearch = !query || name.includes(query) || textContent.includes(query);
      const matchesCategory = activeCategory === 'all' || cat === activeCategory;

      if (matchesSearch && matchesCategory) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noResultsBox) {
      if (visibleCount === 0) {
        noResultsBox.classList.remove('hidden');
      } else {
        noResultsBox.classList.add('hidden');
      }
    }
  }

  searchInput?.addEventListener('input', filterProducts);

  const activeClasses = ['bg-neutral-950', 'text-white', 'border-neutral-950', 'font-bold', 'active', 'shadow-xs'];
  const inactiveClasses = ['bg-neutral-100', 'text-neutral-900', 'border-neutral-200', 'font-semibold', 'hover:bg-neutral-900', 'hover:text-white', 'hover:border-neutral-900'];

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      activeCategory = pill.getAttribute('data-cat') || 'all';

      pills.forEach((p) => {
        p.classList.remove(...activeClasses);
        p.classList.add(...inactiveClasses);
      });

      pill.classList.remove(...inactiveClasses);
      pill.classList.add(...activeClasses);

      filterProducts();
    });
  });
</script>
