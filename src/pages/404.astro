---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslations } from '../utils/getTranslations';

const lang = 'es';
const t = getTranslations(lang);
const currentPath = '/404';
---

<BaseLayout
  title="Página no encontrada | Page Not Found"
  description="La página solicitada no existe."
  lang={lang}
  currentPath={currentPath}
>
  <div class="max-w-xl mx-auto px-4 py-20 text-center space-y-6">
    <div class="w-20 h-20 mx-auto rounded-full bg-orange-50 text-orange-500 flex items-center justify-center font-serif font-bold text-3xl shadow-soft">
      404
    </div>
    
    <h1 class="text-3xl font-serif font-bold text-neutral-950">
      Página no encontrada
    </h1>
    
    <p class="text-sm text-neutral-600 leading-relaxed max-w-md mx-auto">
      La página que buscas no existe o ha sido movida.
    </p>

    <!-- Single clean button -->
    <div class="pt-4">
      <a
        href="/es/"
        class="inline-block px-8 py-3.5 rounded-2xl bg-neutral-950 text-white text-xs font-bold shadow-soft hover:bg-neutral-800 transition-colors"
      >
        Ir al Inicio
      </a>
    </div>
  </div>
</BaseLayout>
