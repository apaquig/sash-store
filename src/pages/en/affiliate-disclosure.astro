---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getTranslations } from '../../utils/getTranslations';

const lang = 'en';
const t = getTranslations(lang);
const currentPath = '/en/affiliate-disclosure/';

const breadcrumbItems = [
  { label: t.nav.home, url: '/en/' },
  { label: t.nav.affiliateDisclosure },
];
---

<BaseLayout
  title="Amazon Affiliate Disclosure | Transparency"
  description="Legal information regarding our participation in the Amazon.com Associates Program."
  lang={lang}
  currentPath={currentPath}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumbs items={breadcrumbItems} />

    <div class="p-8 sm:p-12 rounded-3xl bg-white border border-neutral-200 shadow-soft space-y-6">
      <span class="inline-block px-3.5 py-1 rounded-full bg-neutral-100 text-neutral-900 text-xs font-bold uppercase tracking-wider">
        Mandatory Legal Notice
      </span>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-neutral-900 leading-tight">
        Amazon Associates Program Disclosure
      </h1>

      <div class="p-6 rounded-2xl bg-neutral-50 border border-neutral-200 space-y-2">
        <p class="text-sm font-semibold text-neutral-900">
          As an Amazon Associate I earn from qualifying purchases.
        </p>
      </div>

      <div class="space-y-4 text-xs text-neutral-700 leading-relaxed">
        <p>
          Sasha Store participates in the Amazon Services LLC Associates Program, an affiliate advertising program designed to provide a means for sites to earn advertising fees by advertising and linking to Amazon.com.
        </p>

        <h2 class="text-base font-serif font-bold text-neutral-900 pt-2">How does this affect your purchase?</h2>
        <p>
          When you click "View on Amazon" and complete a purchase on Amazon.com, we may receive a small referral commission directly from Amazon. <strong>This incurs no extra cost to you</strong>. The price remains identical to navigating directly to Amazon.com.
        </p>

        <h2 class="text-base font-serif font-bold text-neutral-900 pt-2">Trademark Usage</h2>
        <p>
          Amazon and the Amazon logo are trademarks of Amazon.com, Inc. or its affiliates. This site is independently operated and not directly sponsored by Amazon.com Inc.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
