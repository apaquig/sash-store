---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getTranslations } from '../../utils/getTranslations';

const lang = 'en';
const t = getTranslations(lang);
const currentPath = '/en/privacy/';

const breadcrumbItems = [
  { label: t.nav.home, url: '/en/' },
  { label: t.nav.privacy },
];
---

<BaseLayout
  title="Privacy Policy | Sasha Store"
  description="Information about privacy and local storage usage at Sasha Store."
  lang={lang}
  currentPath={currentPath}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumbs items={breadcrumbItems} />

    <div class="p-8 sm:p-12 rounded-3xl bg-white border border-neutral-200 shadow-soft space-y-6">
      <span class="inline-block px-3.5 py-1 rounded-full bg-neutral-100 text-neutral-900 text-xs font-bold uppercase tracking-wider">
        Privacy & Security
      </span>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-neutral-900 leading-tight">
        Privacy Policy
      </h1>

      <div class="space-y-4 text-xs text-neutral-700 leading-relaxed">
        <p>
          At Sasha Store, we value visitor privacy.
        </p>

        <h2 class="text-base font-serif font-bold text-neutral-900 pt-2">1. No Personal Data Collection</h2>
        <p>
          We do not require user accounts or process payments. All purchases take place on Amazon.com.
        </p>

        <h2 class="text-base font-serif font-bold text-neutral-900 pt-2">2. Local Favorites</h2>
        <p>
          We use browser local storage solely to store your saved "Favorite" products on your own device.
        </p>

        <h2 class="text-base font-serif font-bold text-neutral-900 pt-2">3. Links to Amazon</h2>
        <p>
          Clicking on our affiliate buttons redirects you to Amazon.com under their official privacy guidelines.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
