---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import ProductGallery from '../../../components/ProductGallery.astro';
import AffiliateButton from '../../../components/AffiliateButton.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { getTranslations } from '../../../utils/getTranslations';
import productsData from '../../../data/products.json';

export async function getStaticPaths() {
  const paths: any[] = [];
  productsData.categories.forEach((category) => {
    category.products.forEach((product) => {
      paths.push({
        params: { slug: product.slug.en },
        props: { product, category },
      });
    });
  });
  return paths;
}

const { product, category } = Astro.props;
const lang = 'en';
const t = getTranslations(lang);
const currentPath = `/en/product/${product.slug.en}/`;

const name = product.name[lang] || product.name.en;
const rawName = (product as any).rawName || name;
const shortDescription = product.shortDescription[lang] || product.shortDescription.en;
const fullDescription = product.fullDescription[lang] || product.fullDescription.en;
const summary = product.summary[lang] || product.summary.en;
const recommendedFor = product.recommendedFor[lang] || product.recommendedFor.en;
const personalReview = product.personalReview[lang] || product.personalReview.en;
const badge = product.badge?.[lang] || product.badge?.en || '#1 Best Seller';

const features = product.features[lang] || product.features.en || [];
const benefits = product.benefits[lang] || product.benefits.en || [];

const relatedProducts = category.products.filter((p: any) => p.id !== product.id).slice(0, 3);
---

<ProductLayout
  product={product}
  category={category}
  lang={lang}
  currentPath={currentPath}
>
  <div class="space-y-12">
    
    <!-- Top Grid: Gallery & Main Info -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Gallery -->
      <div class="lg:col-span-5">
        <ProductGallery
          imageNumber={product.imageNumber}
          imagePrimary={product.imagePrimary}
          imageSecondary={product.imageSecondary}
          imageAlt={product.imageAlt}
          lang={lang}
        />
      </div>

      <!-- Right Column: Product Core Info & CTA -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Badges & Top Badge Row CTA Button (variant="badge") -->
        <div class="flex items-center space-x-3 flex-wrap gap-y-2">
          <span class="px-3 py-1 rounded-sm bg-[#c45500] text-white text-xs font-bold shadow-xs uppercase tracking-wider">
            {badge}
          </span>
          {product.brand && (
            <span class="px-3 py-1 rounded-full bg-neutral-100 text-neutral-800 border border-neutral-300 text-xs font-semibold">
              Brand: {product.brand}
            </span>
          )}
          <AffiliateButton
            url={product.affiliateUrl}
            isDemo={product.isDemo}
            lang={lang}
            buttonText={t.products.viewOnAmazon}
            variant="badge"
          />
        </div>

        <!-- Product Name -->
        <h1 class="text-lg sm:text-xl font-sans font-bold text-neutral-950 leading-snug tracking-tight">
          {rawName}
        </h1>

        <!-- Personal Rating & Total Reviews -->
        <div class="flex items-center space-x-3 pb-4 border-b border-neutral-200">
          <div class="flex text-amber-400">
            {Array.from({ length: 5 }).map((_, i) => (
              <svg class={`w-5 h-5 ${i < Math.floor(product.personalRating) ? 'fill-current' : 'text-neutral-200'}`} viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
              </svg>
            ))}
          </div>
          <span class="text-sm font-bold text-neutral-900">{product.personalRating} / 5.0</span>
          {product.totalReviews > 0 && (
            <span class="text-xs text-neutral-500 font-medium">({product.totalReviews.toLocaleString()} reviews on Amazon)</span>
          )}
        </div>

        <!-- Short Description -->
        <p class="text-base text-neutral-800 leading-relaxed font-normal">
          {shortDescription}
        </p>

        <!-- Price Display -->
        {product.price > 0 && (
          <div class="flex items-baseline space-x-2">
            <span class="text-3xl font-serif font-black text-neutral-950">${product.price.toFixed(2)}</span>
            <span class="text-xs text-neutral-500 font-bold uppercase">{product.currency || 'USD'}</span>
          </div>
        )}

        <!-- Key Features & Pros Box -->
        <div class="p-5 rounded-2xl bg-neutral-50 border border-neutral-200 space-y-4">
          <!-- Features -->
          {features && features.length > 0 && (
            <div class="space-y-2">
              <h2 class="text-xs font-bold uppercase tracking-wider text-neutral-900 flex items-center space-x-1.5">
                <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>Key Features</span>
              </h2>
              <ul class="space-y-1.5 text-xs text-neutral-800">
                {features.map((item: string) => (
                  <li class="flex items-start space-x-2">
                    <span class="text-orange-500 font-bold text-sm leading-none">&bull;</span>
                    <span class="leading-relaxed font-medium">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Benefits / Pros -->
          {benefits && benefits.length > 0 && (
            <div class="pt-3 border-t border-neutral-200/80 space-y-2">
              <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-900 flex items-center space-x-1.5">
                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Key Benefits & Pros</span>
              </h3>
              <ul class="space-y-1.5 text-xs text-neutral-800">
                {benefits.map((item: string) => (
                  <li class="flex items-start space-x-2">
                    <span class="text-emerald-600 font-bold text-sm leading-none">&#10003;</span>
                    <span class="leading-relaxed font-medium">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <!-- Main Product Hero CTA Button (variant="hero") -->
        <div class="pt-4 space-y-3">
          <AffiliateButton
            url={product.affiliateUrl}
            isDemo={product.isDemo}
            lang={lang}
            buttonText={t.products.viewOnAmazon}
            variant="hero"
          />
          <p class="text-[11px] text-center text-neutral-500">
            {t.products.externalLinkNote}
          </p>
        </div>

      </div>
    </div>

    <!-- Detailed Full Product Description Section -->
    {fullDescription && (
      <div class="p-8 sm:p-10 rounded-3xl bg-white border border-neutral-200 shadow-soft space-y-4">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-neutral-900">
          Detailed Product Overview
        </h2>
        <div class="text-sm text-neutral-700 leading-relaxed whitespace-pre-line">
          {fullDescription}
        </div>
      </div>
    )}

    <!-- Editorial Personal Review -->
    {personalReview && (
      <div class="p-8 sm:p-10 rounded-3xl bg-neutral-50 border border-neutral-200 shadow-soft space-y-6">
        <div class="flex items-center justify-between flex-wrap gap-4">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-full bg-neutral-900 text-white flex items-center justify-center font-serif font-bold text-base">
              S
            </div>
            <div>
              <h3 class="text-base font-serif font-bold text-neutral-900">Sasha Store Editorial Review</h3>
              <p class="text-xs text-neutral-500">Verified Product Assessment</p>
            </div>
          </div>

          <!-- Social Follow Bar -->
          <div class="flex items-center space-x-2">
            <span class="text-xs font-bold text-neutral-600">Follow us:</span>
            <a href="https://www.instagram.com/sassha_steele" target="_blank" rel="noopener noreferrer" class="p-1.5 rounded-full bg-gradient-to-tr from-[#f09433] via-[#dc2743] to-[#bc1888] text-white hover:scale-110 transition-transform shadow-xs" title="Instagram: @sassha_steele">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href="https://www.tiktok.com/@sasha_steele.ai" target="_blank" rel="noopener noreferrer" class="p-1.5 rounded-full bg-neutral-900 text-white hover:scale-110 transition-transform shadow-xs" title="TikTok: @sasha_steele.ai">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
            </a>
            <a href="https://www.pinterest.com/sofiahonzalezoff" target="_blank" rel="noopener noreferrer" class="p-1.5 rounded-full bg-[#e60023] text-white hover:scale-110 transition-transform shadow-xs" title="Pinterest: @sofiahonzalezoff">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026z"/></svg>
            </a>
            <a href="https://www.facebook.com/sashasteele.official" target="_blank" rel="noopener noreferrer" class="p-1.5 rounded-full bg-[#1877f2] text-white hover:scale-110 transition-transform shadow-xs" title="Facebook: sashasteele.official">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          </div>
        </div>

        <p class="text-sm text-neutral-800 leading-relaxed italic whitespace-pre-line">
          "{personalReview}"
        </p>

        <!-- Safety Notes -->
        {product.seo_geo?.notas_de_seguridad?.[lang] && product.seo_geo.notas_de_seguridad[lang].length > 0 && (
          <div class="p-5 rounded-xl bg-amber-50/60 border border-amber-200/80 space-y-2.5">
            <h4 class="text-xs font-bold uppercase tracking-wider text-amber-900 flex items-center space-x-1.5">
              <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
              <span>Safety & Usage Notes</span>
            </h4>
            <ul class="space-y-1 text-xs text-amber-950/90 list-disc list-inside">
              {product.seo_geo.notas_de_seguridad[lang].map((nota: string) => (
                <li class="leading-relaxed">{nota}</li>
              ))}
            </ul>
          </div>
        )}

        <div class="pt-4 border-t border-neutral-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900">Recommended For:</h4>
            <p class="text-xs text-neutral-700 mt-1">{recommendedFor}</p>
          </div>
          <div class="flex-shrink-0">
            <AffiliateButton
              url={product.affiliateUrl}
              isDemo={product.isDemo}
              lang={lang}
              buttonText={t.products.viewOnAmazon}
              variant="primary"
            />
          </div>
        </div>
      </div>
    )}

    <!-- FAQs Section -->
    {product.seo_geo?.faqs && product.seo_geo.faqs.length > 0 && (
      <div class="p-8 sm:p-10 rounded-3xl bg-white border border-neutral-200 shadow-soft space-y-6">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-neutral-900 flex items-center space-x-2">
          <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>Frequently Asked Questions (FAQ)</span>
        </h2>
        <div class="space-y-4 divide-y divide-neutral-200">
          {product.seo_geo.faqs.map((faq: any, idx: number) => (
            <div class={idx === 0 ? "space-y-2" : "space-y-2 pt-4"}>
              <h3 class="text-sm sm:text-base font-bold text-neutral-900 flex items-start space-x-2">
                <span class="text-orange-500 font-bold">Q:</span>
                <span>{faq.pregunta[lang] || faq.pregunta.es}</span>
              </h3>
              <p class="text-xs sm:text-sm text-neutral-700 leading-relaxed pl-6">
                {faq.respuesta[lang] || faq.respuesta.es}
              </p>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <div class="space-y-6 pt-8 border-t border-neutral-200">
        <h2 class="text-2xl font-serif font-bold text-neutral-900">
          Related Products in {category.name.en}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedProducts.map((rel: any) => (
            <ProductCard product={rel} lang={lang} t={t} />
          ))}
        </div>
      </div>
    )}

  </div>
</ProductLayout>
