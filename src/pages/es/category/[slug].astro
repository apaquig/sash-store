---
import productsData from '../../../data/products.json';

export function getStaticPaths() {
  const paths: Array<{ params: { slug: string }; props: { targetSlug: string } }> = [];

  productsData.categories.forEach((cat) => {
    paths.push({
      params: { slug: cat.slug.en },
      props: { targetSlug: cat.slug.es },
    });
  });

  return paths;
}

const { targetSlug } = Astro.props;
return Astro.redirect(`/es/categoria/${targetSlug}/`);
---
