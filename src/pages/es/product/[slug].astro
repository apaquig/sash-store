---
import productsData from '../../../data/products.json';

export function getStaticPaths() {
  const paths: Array<{ params: { slug: string }; props: { targetSlug: string } }> = [];

  productsData.categories.forEach((cat) => {
    cat.products.forEach((prod) => {
      paths.push({
        params: { slug: prod.slug.en },
        props: { targetSlug: prod.slug.es },
      });
    });
  });

  return paths;
}

const { targetSlug } = Astro.props;
return Astro.redirect(`/es/producto/${targetSlug}/`);
