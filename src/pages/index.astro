---
const baseUrl = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sasha Store | Redirecting...</title>
    
    <!-- Limpieza de Service Worker (PWA Fix) -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function(registrations) {
          for(let registration of registrations) {
            registration.unregister();
          }
          // Force a reload to clear SW interception if it was stuck
          if (registrations.length > 0) window.location.reload();
        });
      }
    </script>

    <!-- Fallback redirect using base URL -->
    <meta http-equiv="refresh" content={`0;url=${baseUrl}es/`} />

    <!-- Instant client-side browser language detection & saved preference -->
    <script is:inline define:vars={{ baseUrl }}>
      (function() {
        try {
          var prefix = baseUrl.endsWith('/') ? baseUrl : baseUrl + '/';
          var savedLang = localStorage.getItem('preferred_lang');
          if (savedLang === 'en' || savedLang === 'es') {
            window.location.replace(prefix + savedLang + '/');
            return;
          }

          var userLang = (navigator.language || navigator.userLanguage || '').toLowerCase();
          if (userLang.indexOf('es') === 0) {
            window.location.replace(prefix + 'es/');
          } else {
            window.location.replace(prefix + 'en/');
          }
        } catch (e) {
          var prefix = baseUrl.endsWith('/') ? baseUrl : baseUrl + '/';
          window.location.replace(prefix + 'es/');
        }
      })();
    </script>
  </head>
  <body class="bg-white text-neutral-900 flex items-center justify-center min-h-screen">
    <p class="text-xs font-semibold text-neutral-500">Redirecting to Sasha Store...</p>
  </body>
</html>
