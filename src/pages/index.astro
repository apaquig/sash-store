<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sasha Store | Redirecting...</title>
    
    <!-- Fallback redirect to English for non-JS environments -->
    <meta http-equiv="refresh" content="0;url=/en/" />

    <!-- Instant client-side browser language detection -->
    <script is:inline>
      (function() {
        try {
          var userLang = (navigator.language || navigator.userLanguage || '').toLowerCase();
          if (userLang.indexOf('es') === 0) {
            window.location.replace('/es/');
          } else {
            window.location.replace('/en/');
          }
        } catch (e) {
          window.location.replace('/en/');
        }
      })();
    </script>
  </head>
  <body class="bg-white text-neutral-900 flex items-center justify-center min-h-screen">
    <p class="text-xs font-semibold text-neutral-500">Redirecting to Sasha Store...</p>
  </body>
</html>
